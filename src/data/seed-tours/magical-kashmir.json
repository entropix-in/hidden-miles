                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "quote",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "The houseboat stay and the shikara ride at sunrise were the highlight of our trip. Everything ran like clockwork. - Ananya & Rahul, Bengaluru",

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=www
DB_USER=user
DB_PASSWORD=password

# Admin panel (server-only). Use long random values in production.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string


# Traveller accounts (Better Auth). Signs session cookies; generate with
# `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Google sign-in (optional). Create an OAuth client at
# https://console.cloud.google.com/auth/clients. The button appears once both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Account emails via Zoho (cpaas.zoho.com): email confirmation, password
# reset, email change. EMAIL_FROM must be a verified sender in Zoho. Without
# the key, links are logged to the server console and email confirmation is
# skipped, so you can still test locally.
ZOHO_EMAIL_HOST=cpaas.zoho.in
ZOHO_EMAIL_API_KEY=
EMAIL_FROM=Hidden Miles <website@thehiddenmiles.com>
# Optional
EMAIL_REPLY_TO=
ZOHO_BOUNCE_ADDRESS=

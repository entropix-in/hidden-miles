NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=www
DB_USER=user
DB_PASSWORD=password

# Admin panel (server-only). Use long random values in production.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Account emails (Resend): email confirmation, password reset, email change.
# Without a key, links are logged to the server console and email
# confirmation is skipped, so you can still test locally.
RESEND_API_KEY=
EMAIL_FROM="Hidden Miles <hello@hiddenmiles.in>"

# Traveller accounts (Better Auth). Signs session cookies; generate with
# `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Google sign-in (optional). Create an OAuth client at
# https://console.cloud.google.com/auth/clients. The button appears once both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

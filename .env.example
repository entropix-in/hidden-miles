NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=www
DB_USER=user
DB_PASSWORD=password

# Admin panel (server-only). Use long random values in production.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Password reset email (Resend). Without a key, reset links are logged to the
# server console so you can still test locally.
RESEND_API_KEY=
EMAIL_FROM="Hidden Miles <hello@hiddenmiles.in>"

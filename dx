#! /usr/bin/env bash
set -euo pipefail

COMMAND="${1:-help}"
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$BASE_DIR"

if [ ! -f extra/docker/local/.env ]; then
    cp extra/docker/local/.env.example extra/docker/local/.env
fi

COMPOSE=(docker compose --env-file extra/docker/local/.env -f extra/docker/local/docker-compose.yml)

case "$COMMAND" in
    setup)
        shift
        exec "$BASE_DIR/extra/scripts/setup.sh" "$@"
        ;;
    up)
        shift
        exec "${COMPOSE[@]}" up "$@"
        ;;
    upd)
        shift
        exec "${COMPOSE[@]}" up -d --build "$@"
        ;;
    down)
        shift
        exec "${COMPOSE[@]}" down "$@"
        ;;
    logs)
        shift
        exec "${COMPOSE[@]}" logs -f "$@"
        ;;
    build)
        shift
        exec "${COMPOSE[@]}" build "$@"
        ;;
    exec)
        shift
        exec "${COMPOSE[@]}" exec www "$@"
        ;;
    help | -h | --help)
        cat <<'EOF'
Hidden Miles Docker helper

  ./dx setup            Build and start the local stack (app + MySQL)
  ./dx up               Start the local stack in the foreground
  ./dx upd              Build and start the local stack in the background
  ./dx down             Stop the local stack
  ./dx logs [service]   Follow service logs
  ./dx build            Build the development image
  ./dx exec <command>   Run a command inside the app container
  ./dx <command>        Shorthand for: ./dx exec <command>

Examples:
  ./dx pnpm add lucide-react
  ./dx pnpm lint
  ./dx sh

Admin:
  http://localhost:3000/admin

Database:
  MySQL on localhost:3307 (hiddenmiles / hiddenmiles)
  phpMyAdmin (optional):
    docker compose --env-file extra/docker/local/.env \
      -f extra/docker/local/docker-compose.yml --profile tools up -d phpmyadmin
  http://localhost:88
EOF
        ;;
    *)
        exec "${COMPOSE[@]}" exec www "$@"
        ;;
esac

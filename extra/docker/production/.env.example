# Copy to .env (or export these) before deploying.
# The compose file provides safe defaults for local testing only.

IMAGE_TAG=latest
APP_PORT=3000
NEXT_PUBLIC_SITE_URL=https://hiddenmiles.in

# MySQL
DB_NAME=hiddenmiles
DB_USER=hiddenmiles
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Admin panel - use long random values and keep them secret.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
